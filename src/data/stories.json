[
  {
    "id": "story-20260523225948",
    "title": "경찰대 기출문제 풀고 멘붕온 고3 썰",
    "publisher": "수학주식",
    "posterImage": "/stories/c1018236.jpg",
    "pages": [
      {
        "id": "page1",
        "bgImage": "/stories/c1018236.jpg",
        "heading": "\"나 전교 1등인데?\" 자신만만했던 고3의 도전"
      },
      {
        "id": "page2",
        "bgImage": "/stories/687c6f51.jpg",
        "heading": "경찰대 국어 1번 지문을 읽은 순간..."
      },
      {
        "id": "page3",
        "bgImage": "/stories/03d1f1d4.jpg",
        "heading": "이게 한국어냐? 외계어냐?"
      },
      {
        "id": "page4",
        "bgImage": "/stories/fce1d88b.jpg",
        "heading": "시험 시작 30분, 내 멘탈은 가루가 되었다"
      },
      {
        "id": "page5",
        "bgImage": "/stories/06bc31c5.jpg",
        "heading": "빨간 비가 내리는 내 시험지"
      },
      {
        "id": "page6",
        "bgImage": "/stories/387010bf.jpg",
        "heading": "겸손하게 수능 공부나 하러 갑니다..."
      }
    ],
    "outlinkText": "수능 수학 기출 무료 다운로드",
